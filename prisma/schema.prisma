// ============================================================
// VOICEFORGE (Module 45)
// ============================================================
//
// These three models back src/backend/services/voiceforge.service.ts and
// voiceforge-compliance.ts, which query prisma.voiceCall,
// prisma.callComplianceScan and prisma.callQaScore. The models did not exist,
// so every VoiceForge call threw at runtime. Columns below are derived from
// the services' own create()/select() shapes.

model VoiceCall {
  id         String  @id @default(uuid())
  tenantId   String
  businessId String
  advisorId  String?

  // Twilio linkage
  twilioCallSid String?
  recordingSid  String?
  recordingUrl  String?

  toPhoneNumber   String
  fromPhoneNumber String
  direction       String // outbound | inbound
  status          String @default("queued") // queued | ringing | in_progress | completed | failed | busy | no_answer

  purpose      String
  campaignType String?
  campaignId   String?

  durationSeconds Int?
  transcriptText  String?
  /**
   * Document Vault entry holding the immutable call log
   */
  documentVaultId String?

  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime  @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  complianceScans CallComplianceScan[]
  qaScores        CallQaScore[]

  @@index([tenantId, businessId])
  @@index([tenantId, status])
  @@index([twilioCallSid])
  @@map("voice_calls")
}

model CallComplianceScan {
  id        String @id @default(uuid())
  tenantId  String
  callId    String
  advisorId String

  riskScore              Int
  riskLevel              String // low | medium | high | critical
  violationCount         Int    @default(0)
  criticalViolationCount Int    @default(0)
  complianceStatus       String // pass | review | fail

  /**
   * Serialised violation and disclosure detail (written with JSON.stringify)
   */
  violationsJson  String
  disclosuresJson String

  /**
   * True when scanned mid-call rather than post-call
   */
  isLiveScan Boolean  @default(false)
  scannedAt  DateTime @default(now())

  tenant Tenant    @relation(fields: [tenantId], references: [id])
  call   VoiceCall @relation(fields: [callId], references: [id])

  @@index([tenantId, callId])
  @@index([tenantId, complianceStatus])
  @@map("call_compliance_scans")
}

model CallQaScore {
  id        String @id @default(uuid())
  tenantId  String
  callId    String
  advisorId String

  overallScore       Int
  complianceScore    Int?
  scriptAdherence    Int?
  tcpaHandling       Int?
  consentCapture     Int?
  riskClaimAvoidance Int?
  disclosureDelivery Int?

  grade    String // A | B | C | D | F
  feedback String?
  scoredAt DateTime @default(now())

  tenant Tenant    @relation(fields: [tenantId], references: [id])
  call   VoiceCall @relation(fields: [callId], references: [id])

  @@index([tenantId, advisorId])
  @@index([tenantId, callId])
  @@map("call_qa_scores")
}

// ── Business credit builder ──────────────────────────────────
// Vendor tradelines opened to build business credit, and disputes raised
// against them. These were previously held in a process-memory object, so a
// tradeline a client "added" vanished on the next restart.

model VendorTradeline {
  id           String    @id @default(uuid())
  tenantId     String
  businessId   String
  vendor       String
  creditLimit  Decimal?
  balance      Decimal   @default(0)
  /**
   * net_30 | net_60 | net_90 — how long after a charge payment is due.
   */
  paymentTerms String?
  status       String    @default("open") // open | closed | delinquent
  /**
   * Bureaus this vendor reports to, e.g. ["D&B","Experian"]
   */
  reportsTo    Json?
  openedDate   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business Business           @relation(fields: [businessId], references: [id])
  disputes TradelineDispute[]
  payments TradelinePayment[]

  @@index([businessId, status])
  @@index([tenantId])
  @@map("vendor_tradelines")
}

/// A client's progress through the six DUNS-track steps on /credit-builder.
///
/// The page held these in component state. Three consequences: a reload wiped
/// them, they were not keyed to anybody — marks made against one client stayed
/// on screen after switching to another — and `tier1Unlocked` read the count,
/// so the "ready for Tier 1 stacking" banner rested partly on three checkboxes
/// that survived neither a refresh nor a change of client.
///
/// Marked by an advisor, not observed by the system: `completedBy` records who
/// asserted it. Steps 4 and 5 have machine-readable proxies elsewhere (the
/// tradeline count and the PAYDEX score), and those are shown alongside rather
/// than folded in — a mark is a claim about the world, and the two must stay
/// distinguishable.
model CreditBuilderStep {
  id          String    @id @default(uuid())
  tenantId    String
  businessId  String
  /**
   * 1–6, matching the DUNS registration track on /credit-builder.
   */
  stepNumber  Int
  completed   Boolean   @default(false)
  completedAt DateTime?
  /**
   * User id of whoever marked it. Null for a step that was never completed.
   */
  completedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, stepNumber])
  @@index([tenantId])
  @@map("credit_builder_steps")
}

/// An observed change in which track a client qualifies for.
///
/// The graduation engine computes a track from live data every time it is
/// asked; nothing recorded that it had *changed*, so "graduationRate" had
/// nothing to count and was published as null with "graduated is undefined".
///
/// A row is written when an assessment finds a different track from the last
/// one recorded, and one baseline row when a client is first assessed
/// (`fromTrack` null). Transitions can go down as well as up — a client whose
/// utilisation rises can stop qualifying for a track — so the direction is
/// derived from the track order rather than assumed.
///
/// Deliberately not a status column on Business: a track is not a property a
/// client has, it is a conclusion drawn from their data at a moment. Storing
/// the conclusion would make it stale the moment anything underneath it moved.
model GraduationEvent {
  id         String   @id @default(uuid())
  tenantId   String
  businessId String
  /**
   * Null on the first observation: there was no previous track to move from.
   */
  fromTrack  String?
  toTrack    String
  observedAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([tenantId, observedAt])
  @@index([businessId, observedAt])
  @@map("graduation_events")
}

model TradelineDispute {
  id             String    @id @default(uuid())
  tenantId       String
  tradelineId    String
  reason         String
  status         String    @default("pending") // pending | submitted | resolved | rejected
  resolutionNote String?
  filedAt        DateTime  @default(now())
  resolvedAt     DateTime?

  tradeline VendorTradeline @relation(fields: [tradelineId], references: [id], onDelete: Cascade)

  @@index([tradelineId, status])
  @@index([tenantId])
  @@map("tradeline_disputes")
}

// ── Outbound messaging safety ────────────────────────────────
// TCPA infrastructure for SMS and voice outreach. The campaign code already
// queried a do-not-call table defensively (`.catch(() => null)`), but no such
// model existed — so the DNC check silently passed for every recipient.

model DoNotCallList {
  id          String   @id @default(uuid())
  tenantId    String
  /**
   * E.164 number. Stored normalised so lookups cannot miss on formatting.
   */
  phoneNumber String
  businessId  String?
  /**
   * opt_out | manual | litigation | bounce
   */
  source      String   @default("opt_out")
  reason      String?
  addedAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, phoneNumber])
  @@index([phoneNumber])
  @@map("do_not_call_list")
}

model SmsMessage {
  id              String   @id @default(uuid())
  tenantId        String
  businessId      String?
  /**
   * Provider message id; null when the send never reached the provider.
   */
  providerSid     String?
  direction       String   @default("outbound") // outbound | inbound
  toPhoneNumber   String
  fromPhoneNumber String
  body            String
  /**
   * queued | sent | delivered | failed | undelivered | blocked | received
   */
  status          String   @default("queued")
  /**
   * Why a message was not sent: dnc | no_consent | quiet_hours | no_phone
   */
  blockedReason   String?
  errorCode       String?
  campaignId      String?
  purpose         String?
  sentAt          DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  business Business? @relation(fields: [businessId], references: [id])

  @@index([tenantId, campaignId])
  @@index([businessId, sentAt])
  @@index([providerSid])
  @@map("sms_messages")
}

model TradelinePayment {
  id          String    @id @default(uuid())
  tenantId    String
  tradelineId String
  amount      Decimal
  paidOn      DateTime
  /**
   * When it was due. Null when the caller could not say.
   */
  dueOn       DateTime?
  /**
   * Whether it was paid by the due date.
   * Null when no due date was known — for a vendor tradeline the whole point
   * is the on-time record that builds PAYDEX, so an unknown must not be
   * recorded as on time.
   */
  onTime      Boolean?
  method      String?
  note        String?
  createdAt   DateTime  @default(now())

  tradeline VendorTradeline @relation(fields: [tradelineId], references: [id], onDelete: Cascade)

  @@index([tradelineId, paidOn])
  @@index([tenantId])
  @@map("tradeline_payments")
}
