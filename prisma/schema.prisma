generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// IDENTITY & MULTI-TENANT
// ============================================================

model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  brandConfig Json?
  plan        String   @default("starter")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users               User[]
  businesses          Business[]
  ledgerEvents        LedgerEvent[]
  consentRecords      ConsentRecord[]
  complianceChecks    ComplianceCheck[]
  documents           Document[]
  branding            TenantBranding?
  voiceCalls          VoiceCall[]
  callComplianceScans CallComplianceScan[]
  callQaScores        CallQaScore[]
  doNotCallList       DoNotCallList[]
  smsMessages         SmsMessage[]

  @@map("tenants")
}

model TenantBranding {
  id             String   @id @default(uuid())
  tenantId       String   @unique
  displayName    String?
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String? // hex color e.g. #C9A84C
  customDomain   String?
  emailFromName  String?
  emailFromAddr  String?
  hideCfBranding Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_brandings")
}

model User {
  id                String    @id @default(uuid())
  tenantId          String
  email             String
  passwordHash      String?
  firstName         String
  lastName          String
  role              String    @default("advisor")
  /**
   * Enrolment is `mfaEnabled && mfaSecret != null`, never the flag alone.
   * `admin@demoadvisors.io` was found with mfaEnabled = true and a null
   * secret: the old routes kept state in a process-local Map and never wrote
   * these columns, so the flag was set by something that left no credential
   * behind. Enforcing on the flag alone would have locked that account out
   * permanently — nothing to verify against and no recovery codes.
   * See isMfaEnrolled() in two-factor.service.ts.
   */
  mfaEnabled        Boolean   @default(false)
  /**
   * TOTP secret, encrypted at rest via encryption.service (never plaintext).
   */
  mfaSecret         String?
  mfaEnrolledAt     DateTime?
  /**
   * The last TOTP time-step accepted for this user.
   * A code stays valid for its whole 30-second window, so without this a
   * code observed once can be replayed until the window closes. A step at or
   * below this value is refused.
   */
  mfaLastUsedStep   Int?
  mfaFailedAttempts Int       @default(0)
  mfaLockedUntil    DateTime?
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant        Tenant                  @relation(fields: [tenantId], references: [id])
  auditLogs     AuditLog[]
  recoveryCodes TwoFactorRecoveryCode[]
  advisorDeals  Business[]              @relation("AdvisorBusinesses")

  @@unique([tenantId, email])
  @@map("users")
}

/**
 * Single-use recovery codes, stored hashed.
 * Without these a lost device is a lost account, and support routes around
 * the control — which is worse than not having it, because the bypass becomes
 * routine and undocumented.
 * Hashed with bcrypt, like a password: this table is exactly as sensitive as
 * the password column, because a code in it is a login.
 */
model TwoFactorRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  /**
   * Set when spent. Rows are kept so "which code was used, when" survives.
   */
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("two_factor_recovery_codes")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  tenantId   String
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  timestamp  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([tenantId, timestamp])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

// ============================================================
// CARD PRODUCT CATALOG
// ============================================================

model CardProduct {
  id                 String   @id @default(uuid())
  issuerId           String // issuer name string (e.g. "chase", "amex")
  name               String
  cardType           String // business_credit | business_charge | secured
  annualFee          Decimal  @default(0)
  annualFeeWaivedY1  Boolean  @default(false)
  aprIntro           Decimal? // intro APR percentage, null = no intro
  aprIntroMonths     Int? // intro APR duration in months
  aprPostPromo       Decimal? // regular/post-promo APR
  creditLimitMin     Int      @default(0)
  creditLimitMax     Int      @default(0)
  creditLimitTypical Int      @default(0)
  scoreMinimum       Int      @default(0) // minimum FICO
  revenueMinimum     Decimal  @default(0) // minimum annual revenue
  businessAgeMinimum Int      @default(0) // minimum months in business
  rewardsType        String? // cash_back | points | miles
  /**
   * Primary rewards rate, as a PERCENT: 2 means 2% cash back, 1.5 means 1.5x.
   * Both conventions were in this table at once — 28 rows as a percent and 12
   * as a fraction, for the same products — because two seed sources disagreed.
   * The optimizer and the card list both read this number as a percent, so a
   * fraction rendered as "0.02% cash back" beside "2% cash back" for one card.
   * Anything below 1 is a fraction that was never converted; see
   * scripts/dedupe-card-products.ts and the guard in prisma/seeds/card-products.ts.
   */
  rewardsRate        Decimal?
  rewardsDetails     String? // human-readable rewards description
  welcomeBonus       String? // welcome bonus description
  welcomeBonusValue  Decimal? // estimated dollar value of welcome bonus
  personalGuarantee  Boolean  @default(true)
  approvalDifficulty String   @default("moderate") // easy | moderate | hard | very_hard
  bestFor            String? // short description of ideal use case
  isActive           Boolean  @default(true)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  /**
   * One row per product per issuer.
   * The primary key is derived from the issuer spelling, so two seed lists
   * spelling it differently ("capital_one" / "capital-one") produced two rows
   * for the same card with two ids and no complaint from the database. The
   * optimizer then recommended the same product twice in one plan.
   */
  @@unique([issuerId, name])
  @@index([issuerId])
  @@index([cardType])
  @@index([isActive])
  @@map("card_products")
}

// ============================================================
// BUSINESS & ONBOARDING
// ============================================================

model Business {
  id               String    @id @default(uuid())
  tenantId         String
  advisorId        String?
  legalName        String
  dba              String?
  ein              String?
  entityType       String
  stateOfFormation String?
  dateOfFormation  DateTime?
  mcc              String?
  /**
   * NAICS industry code. Referenced by the client PATCH allowlist and the
   * edit-profile form since before it existed as a column, so saving it
   * passed validation and then failed at the database with a 500.
   */
  naicsCode        String?
  industry         String?
  annualRevenue    Decimal?
  monthlyRevenue   Decimal?
  employees        Int?
  website          String?

  /**
   * Business address and email.
   * The onboarding wizard has always collected these — address line 1, city,
   * state and ZIP are required to leave its first step — and there was
   * nowhere to put them. The create validator dropped them as unknown keys
   * and no column existed, so the one part of the form a user could not skip
   * was the part guaranteed to be discarded.
   */
  addressLine1          String?
  addressLine2          String?
  city                  String?
  state                 String?
  zip                   String?
  businessEmail         String?
  /**
   * IANA timezone for this client, e.g. "America/Chicago".
   * Quiet-hours rules are stated in the recipient's local time, so outreach
   * needs to know it. When null the dispatcher derives one from the phone
   * number's area code and refuses to send if it cannot.
   */
  timezone              String?
  /**
   * Primary contact number used by VoiceForge outreach campaigns
   */
  phoneNumber           String?
  fundingReadinessScore Int?
  status                String   @default("intake")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant             Tenant                  @relation(fields: [tenantId], references: [id])
  advisor            User?                   @relation("AdvisorBusinesses", fields: [advisorId], references: [id])
  owners             BusinessOwner[]
  creditProfiles     CreditProfile[]
  fundingRounds      FundingRound[]
  cardApplications   CardApplication[]
  complianceChecks   ComplianceCheck[]
  consentRecords     ConsentRecord[]
  documents          Document[]
  suitabilityChecks  SuitabilityCheck[]
  voiceCalls         VoiceCall[]
  repaymentPlans     RepaymentPlan[]
  acknowledgments    ProductAcknowledgment[]
  achAuthorizations  AchAuthorization[]
  vendorTradelines   VendorTradeline[]
  smsMessages        SmsMessage[]
  costCalculations   CostCalculation[]
  creditBuilderSteps CreditBuilderStep[]
  graduationEvents   GraduationEvent[]

  @@index([tenantId, status])
  @@map("businesses")
}

model BusinessOwner {
  id                String    @id @default(uuid())
  businessId        String
  firstName         String
  lastName          String
  /**
   * Role at the business, e.g. "CEO". Rendered on the client profile card
   * since before it was a column, so it always read blank.
   */
  title             String?
  ownershipPercent  Decimal
  ssn               String?
  /**
   * Last four digits only.
   * The add-owner form asks for four digits; `ssn` holds a full nine and its
   * validator rejects anything shorter. Keeping them apart means the short
   * form cannot quietly become the record of a full SSN, and nothing here
   * stores more of one than it needs.
   */
  ssnLast4          String?
  dateOfBirth       DateTime?
  address           Json?
  /**
   * Whether this owner personally guarantees the debt. Also rendered on the
   * profile card ("PG: Yes"/"PG: No") before it could be recorded, so it
   * answered "No" for everyone.
   */
  personalGuarantee Boolean   @default(false)
  isBeneficialOwner Boolean   @default(true)
  kycStatus         String    @default("pending")
  kycVerifiedAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@map("business_owners")
}

// ============================================================
// CREDIT & INTELLIGENCE
// ============================================================

model CreditProfile {
  id              String   @id @default(uuid())
  businessId      String
  profileType     String // personal | business
  bureau          String // equifax | transunion | experian | dnb
  score           Int?
  /// fico | vantage | sbss | paydex | intelliscore
  ///
  /// The name of the product, not a category: `intelliscore` is Experian's
  /// business score (1–100) and `sbss` is FICO's (0–300). Business pulls were
  /// written as `sbss` whatever bureau produced them, which made the reader
  /// for Experian's card unsatisfiable.
  scoreType       String?
  utilization     Decimal?
  inquiryCount    Int?
  derogatoryCount Int?
  tradelines      Json?
  rawData         Json?
  pulledAt        DateTime
  createdAt       DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId, bureau, pulledAt])
  @@map("credit_profiles")
}

// ============================================================
// FUNDING & APPLICATIONS
// ============================================================

model FundingRound {
  id              String    @id @default(uuid())
  businessId      String
  roundNumber     Int
  targetCredit    Decimal?
  targetCardCount Int?
  status          String    @default("planning")
  aprExpiryDate   DateTime?
  alertSent60     Boolean   @default(false)
  alertSent30     Boolean   @default(false)
  alertSent15     Boolean   @default(false)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business     Business          @relation(fields: [businessId], references: [id])
  applications CardApplication[]

  @@unique([businessId, roundNumber])
  @@map("funding_rounds")
}

model CardApplication {
  id                  String    @id @default(uuid())
  businessId          String
  fundingRoundId      String?
  issuer              String
  cardProduct         String
  status              String    @default("draft")
  creditLimit         Decimal?
  introApr            Decimal?
  introAprExpiry      DateTime?
  regularApr          Decimal?
  annualFee           Decimal?
  cashAdvanceFee      Decimal?
  consentCapturedAt   DateTime?
  submittedAt         DateTime?
  decidedAt           DateTime?
  /// When the card was cancelled, which is not a decision on the application.
  /// Without it a cancelled card could not be placed in time, so the
  /// active-applications history had to drop it entirely.
  cancelledAt         DateTime?
  declineReason       String?
  adverseActionNotice Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  business     Business      @relation(fields: [businessId], references: [id])
  fundingRound FundingRound? @relation(fields: [fundingRoundId], references: [id])

  @@index([businessId, status])
  @@map("card_applications")
}

model SuitabilityCheck {
  id                  String   @id @default(uuid())
  businessId          String
  score               Int
  maxSafeLeverage     Decimal?
  recommendation      String
  noGoTriggered       Boolean  @default(false)
  noGoReasons         Json?
  alternativeProducts Json?
  decisionExplanation String?
  overriddenBy        String?
  overrideReason      String?
  createdAt           DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])

  @@map("suitability_checks")
}

// ============================================================
// CONSENT & COMPLIANCE
// ============================================================

model ConsentRecord {
  id               String    @id @default(uuid())
  tenantId         String
  businessId       String?
  channel          String // voice | sms | email | partner | document
  consentType      String // tcpa | data_sharing | referral | application
  status           String    @default("active") // active | revoked | expired
  grantedAt        DateTime  @default(now())
  revokedAt        DateTime?
  revocationReason String?
  ipAddress        String?
  evidenceRef      String?
  metadata         Json?

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  business Business? @relation(fields: [businessId], references: [id])

  @@index([tenantId, businessId, channel])
  @@index([status])
  @@map("consent_records")
}

model ProductAcknowledgment {
  id                 String   @id @default(uuid())
  businessId         String
  acknowledgmentType String // product_reality | fee_schedule | personal_guarantee | cash_advance_risk
  version            String
  signedAt           DateTime
  signatureRef       String?
  documentVaultId    String?
  metadata           Json?
  createdAt          DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])

  @@map("product_acknowledgments")
}

model ComplianceCheck {
  id                String    @id @default(uuid())
  tenantId          String
  businessId        String?
  checkType         String // udap | state_law | vendor | kyb
  riskScore         Int?
  riskLevel         String? // low | medium | high | critical
  findings          Json?
  stateJurisdiction String?
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  business Business? @relation(fields: [businessId], references: [id])

  @@index([tenantId, checkType])
  @@map("compliance_checks")
}

// ============================================================
// ACH & DEBIT CONTROLS
// ============================================================

model AchAuthorization {
  id                   String    @id @default(uuid())
  businessId           String
  processorName        String
  authorizedAmount     Decimal?
  authorizedFrequency  String?
  status               String    @default("active") // active | revoked | suspended
  signedDocumentRef    String?
  authorizedAt         DateTime
  revokedAt            DateTime?
  revocationNotifiedAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  business    Business     @relation(fields: [businessId], references: [id])
  debitEvents DebitEvent[]

  @@map("ach_authorizations")
}

model DebitEvent {
  id                String   @id @default(uuid())
  authorizationId   String
  amount            Decimal
  frequency         String?
  isWithinTolerance Boolean  @default(true)
  flagged           Boolean  @default(false)
  flagReason        String?
  processedAt       DateTime
  createdAt         DateTime @default(now())

  authorization AchAuthorization @relation(fields: [authorizationId], references: [id])

  @@map("debit_events")
}

// ============================================================
// FINANCIAL
// ============================================================

model CostCalculation {
  id               String   @id @default(uuid())
  businessId       String
  programFees      Decimal  @default(0)
  percentOfFunding Decimal  @default(0)
  annualFees       Decimal  @default(0)
  cashAdvanceFees  Decimal  @default(0)
  processorFees    Decimal  @default(0)
  totalCost        Decimal  @default(0)
  effectiveApr     Decimal?
  irc163jImpact    Decimal?
  bestCaseFlow     Json?
  baseCaseFlow     Json?
  worstCaseFlow    Json?
  createdAt        DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])

  @@map("cost_calculations")
}

// ============================================================
// CANONICAL LEDGER & EVENT BUS
// ============================================================

model LedgerEvent {
  id            String    @id @default(uuid())
  tenantId      String
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  metadata      Json?
  version       Int       @default(1)
  publishedAt   DateTime  @default(now())
  processedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, eventType])
  @@index([aggregateType, aggregateId])
  @@index([publishedAt])
  @@map("ledger_events")
}

// ============================================================
// DOCUMENT VAULT
// ============================================================

model Document {
  id              String   @id @default(uuid())
  tenantId        String
  businessId      String?
  documentType    String
  title           String
  storageKey      String
  mimeType        String?
  sizeBytes       Int?
  sha256Hash      String?
  cryptoTimestamp String?
  legalHold       Boolean  @default(false)
  metadata        Json?
  uploadedBy      String?
  createdAt       DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  business Business? @relation(fields: [businessId], references: [id])

  @@index([tenantId, documentType])
  @@index([businessId])
  @@map("documents")
}

// ============================================================
// DECLINE RECOVERY & ADVERSE ACTION
// ============================================================

model DeclineRecovery {
  id                    String    @id @default(uuid())
  tenantId              String
  businessId            String
  applicationId         String
  issuer                String
  declineReasons        Json
  adverseActionRaw      String?
  reconsiderationStatus String    @default("pending")
  reconsiderationNotes  String?
  reapplyCooldownDate   DateTime?
  letterGenerated       Boolean   @default(false)
  recoveryStage         String    @default("new")
  resolvedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([tenantId, businessId])
  @@map("decline_recoveries")
}

// ============================================================
// REPAYMENT & TREASURY
// ============================================================

model RepaymentPlan {
  id                  String    @id @default(uuid())
  tenantId            String
  businessId          String
  totalBalance        Decimal
  monthlyPayment      Decimal?
  strategy            String    @default("avalanche")
  status              String    @default("active")
  interestShockDate   DateTime?
  interestShockAmount Decimal?
  nextPaymentDate     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  schedules PaymentSchedule[]
  business  Business          @relation(fields: [businessId], references: [id])

  @@index([tenantId, businessId])
  @@map("repayment_plans")
}

model PaymentSchedule {
  id                 String    @id @default(uuid())
  repaymentPlanId    String
  cardApplicationId  String?
  issuer             String
  dueDate            DateTime
  minimumPayment     Decimal
  recommendedPayment Decimal?
  actualPayment      Decimal?
  status             String    @default("upcoming")
  autopayEnabled     Boolean   @default(false)
  autopayVerified    Boolean   @default(false)
  paidAt             DateTime?
  createdAt          DateTime  @default(now())

  repaymentPlan RepaymentPlan @relation(fields: [repaymentPlanId], references: [id])

  @@index([repaymentPlanId, dueDate])
  @@map("payment_schedules")
}

// ============================================================
// SPEND GOVERNANCE & BUSINESS PURPOSE
// ============================================================

model SpendTransaction {
  id                String   @id @default(uuid())
  tenantId          String
  businessId        String
  cardApplicationId String?
  amount            Decimal
  merchantName      String?
  mcc               String?
  mccCategory       String?
  riskScore         Int?
  isCashLike        Boolean  @default(false)
  businessPurpose   String?
  evidenceDocId     String?
  flagged           Boolean  @default(false)
  flagReason        String?
  transactionDate   DateTime
  createdAt         DateTime @default(now())

  @@index([tenantId, businessId])
  @@index([mcc])
  @@map("spend_transactions")
}

// ============================================================
// REWARDS & CARD BENEFITS
// ============================================================

model RewardsOptimization {
  id                String   @id @default(uuid())
  tenantId          String
  businessId        String
  cardApplicationId String
  mccCategory       String
  rewardsRate       Decimal
  annualValue       Decimal?
  isOptimalCard     Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([tenantId, businessId])
  @@map("rewards_optimizations")
}

model CardBenefit {
  id                String    @id @default(uuid())
  cardApplicationId String
  benefitType       String
  benefitName       String
  benefitValue      Decimal?
  expiryDate        DateTime?
  utilized          Boolean   @default(false)
  utilizedDate      DateTime?
  createdAt         DateTime  @default(now())

  @@map("card_benefits")
}

// ============================================================
// REVENUE OPS & BILLING
// ============================================================

model Invoice {
  id              String    @id @default(uuid())
  tenantId        String
  businessId      String
  invoiceNumber   String
  type            String
  amount          Decimal
  feeBreakdown    Json?
  status          String    @default("draft")
  issuedAt        DateTime?
  dueDate         DateTime?
  paidAt          DateTime?
  stripePaymentId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, businessId])
  @@map("invoices")
}

model CommissionRecord {
  id         String    @id @default(uuid())
  tenantId   String
  invoiceId  String?
  partnerId  String?
  advisorId  String?
  amount     Decimal
  percentage Decimal?
  type       String
  status     String    @default("pending")
  paidAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@map("commission_records")
}

// ============================================================
// STATEMENT RECONCILIATION
// ============================================================

model StatementRecord {
  id                String    @id @default(uuid())
  tenantId          String
  businessId        String
  cardApplicationId String?
  issuer            String
  statementDate     DateTime
  closingBalance    Decimal?
  minimumPayment    Decimal?
  dueDate           DateTime?
  interestCharged   Decimal?
  feesCharged       Decimal?
  sourceDocumentId  String?
  normalizedData    Json?
  anomalies         Json?
  reconciled        Boolean   @default(false)
  createdAt         DateTime  @default(now())

  @@index([tenantId, businessId])
  @@map("statement_records")
}

// ============================================================
// DEAL COMMITTEE
// ============================================================

model DealCommitteeReview {
  id                String    @id @default(uuid())
  tenantId          String
  businessId        String
  riskTier          String
  status            String    @default("pending")
  redFlagChecklist  Json?
  committeeNotes    String?
  conditions        Json?
  counselSignoff    Boolean   @default(false)
  accountantSignoff Boolean   @default(false)
  reviewedBy        Json?
  decidedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId, status])
  @@map("deal_committee_reviews")
}

// ============================================================
// HARDSHIP & WORKOUT
// ============================================================

model HardshipCase {
  id                  String    @id @default(uuid())
  tenantId            String
  businessId          String
  triggerType         String
  severity            String
  status              String    @default("open")
  paymentPlan         Json?
  settlementOffer     Json?
  counselorReferral   String?
  cardClosureSequence Json?
  resolvedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([tenantId, status])
  @@map("hardship_cases")
}

// ============================================================
// COMPLAINTS & REMEDIATION
// ============================================================

model Complaint {
  id             String    @id @default(uuid())
  tenantId       String
  businessId     String?
  category       String
  subcategory    String?
  source         String
  severity       String    @default("medium")
  status         String    @default("open")
  description    String
  evidenceDocIds Json?
  callRecordIds  Json?
  rootCause      String?
  resolution     String?
  assignedTo     String?
  escalatedTo    String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([tenantId, status])
  @@index([category])
