# CapitalForge Environment Variables
# Copy this to .env and fill in real values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/capitalforge
REDIS_URL=redis://localhost:6379

# Authentication
#
# These two are REQUIRED and each must be at least 32 characters. config/auth.ts
# throws on the first token it is asked to sign or verify if either is missing
# or short — so the server boots and then fails at the first login.
#
# This file previously listed a single `JWT_SECRET`, which nothing in the
# codebase reads, and named neither of these. Anybody setting up from it
# configured a variable that did nothing and never learned about the two that
# matter. Generate each with, e.g., `openssl rand -base64 48`.
JWT_ACCESS_SECRET=YOUR_ACCESS_SECRET_HERE_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=YOUR_REFRESH_SECRET_HERE_AT_LEAST_32_CHARS
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
AUTH0_DOMAIN=YOUR_AUTH0_DOMAIN_HERE
AUTH0_CLIENT_ID=YOUR_AUTH0_CLIENT_ID_HERE
AUTH0_CLIENT_SECRET=YOUR_AUTH0_CLIENT_SECRET_HERE

# AI / Claude API
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# Integrations
PLAID_CLIENT_ID=YOUR_PLAID_CLIENT_ID_HERE
PLAID_SECRET=YOUR_PLAID_SECRET_HERE
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_HERE
STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUB_KEY_HERE
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET_HERE
STRIPE_PRICE_STARTER=price_starter_297
STRIPE_PRICE_PRO=price_pro_697
DOCUSIGN_INTEGRATION_KEY=YOUR_DOCUSIGN_KEY_HERE
DOCUSIGN_SECRET_KEY=YOUR_DOCUSIGN_SECRET_HERE
DOCUSIGN_ACCOUNT_ID=YOUR_DOCUSIGN_ACCOUNT_HERE
DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
DOCUSIGN_USER_ID=YOUR_DOCUSIGN_USER_ID_HERE
DOCUSIGN_PRIVATE_KEY=YOUR_DOCUSIGN_PRIVATE_KEY_HERE
DOCUSIGN_WEBHOOK_HMAC_SECRET=YOUR_DOCUSIGN_HMAC_SECRET_HERE
TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_TWILIO_TOKEN_HERE
# The number SMS is sent from. Required: Twilio rejects a send without it.
TWILIO_FROM_NUMBER=+15005550006
# Shifts the 8am-9pm contact window when the server does not run in the
# recipients' timezone. Hours, may be negative.
SMS_TIMEZONE_OFFSET_HOURS=0
# Public base URL Twilio calls back on for delivery receipts and inbound
# messages. Without it, STOP replies cannot reach the app.
API_BASE_URL=http://localhost:4000

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_AWS_KEY_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_HERE
S3_BUCKET_NAME=capitalforge-documents

# Sentry (error monitoring)
NEXT_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN_HERE

# Upstash Redis (AI rate limiting)
UPSTASH_REDIS_REST_URL=YOUR_UPSTASH_URL_HERE
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_TOKEN_HERE

# App
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Data deletion (offboarding)
#
# Both are required for POST /api/offboarding/:id/delete-data. With either
# unset the endpoint answers 503 and nothing is deleted, which is deliberate:
# these used to fall back to constants in the source ('confirm-secret' and
# 'changeme'), so on any deployment that had not set them the confirmation
# token guarding an irreversible tenant-wide erasure was computable from the
# repository, and the signature on the deletion proof certified nothing.
#
# Left unset here on purpose — a copied .env should not be able to delete a
# tenant. Set them per environment, at least 32 characters each:
#   openssl rand -hex 32
#
# DELETION_CONFIRM_SECRET=
# DELETION_PROOF_SECRET=

# ── Credit bureaus ───────────────────────────────────────────
#
# Every adapter in the bureau client generates its answer: a personal pull
# produced a FICO score of 640 + Math.random() * 160, a payment status that
# was "30_days_late" 12% of the time, and a derogatory mark 8% of the time —
# the inputs to a lending decision, invented per call and different on every
# retry.
#
# With none of these set the client refuses to answer at all, which is the
# safe default and why they are left unset here. Set the credential for a
# bureau to enable pulls against it; each is gated on its own.
#
# EXPERIAN_CLIENT_ID=
# TRANSUNION_CLIENT_ID=
# EQUIFAX_CLIENT_ID=
# DNB_API_KEY=
#
# BUREAU_MODE=synthetic re-enables the generators without credentials, for
# local work. Every profile they return carries synthetic: true on the record,
# so a generated score cannot be read later as something a bureau said.
# Deliberately not inferred from NODE_ENV: being outside production is not
# consent to invent somebody's credit history.
#
# BUREAU_MODE=synthetic

# ── The Office bridge ────────────────────────────────────────
#
# All four are required together. When any is absent the adapter is NOT MOUNTED
# and /api/office 404s, which The Office reads as "serves no manifest" - the
# truth. A half-configured bridge that answered would tell The Office that
# CapitalForge is bridged when nothing can authenticate to it.
#
# OFFICE_SHARED_SECRET is the tenant credential The Office brokers. It is the
# value behind forge_tenant_credential.credential_ref on that side; the ref
# holds a vault path, never this. Read lazily and compared in constant time -
# see src/backend/config/office.ts for why it is not in config/index.ts.
OFFICE_SHARED_SECRET=

# X-Office-Venture -> CapitalForge tenantId, comma separated.
# An unmapped venture is refused, never guessed: guessing would put one tenant's
# records behind another tenant's venture.
OFFICE_VENTURE_TENANTS=burkham-wickmont:00000000-0000-0000-0000-000000000000

# The user id every brokered call runs as. A real User row, so that anything
# written on a brokered call names something findable rather than a null.
OFFICE_SERVICE_PRINCIPAL_ID=

# Where the adapter posts CapitalForge's own requests. Defaults to
# http://127.0.0.1:${PORT}; set only for an unusual deployment or a test.
# OFFICE_LOOPBACK_BASE=
