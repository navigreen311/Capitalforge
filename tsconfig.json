{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // DOM is here for the tests, not for the backend. Some frontend modules
    // are runtime code worth unit-testing — the token refresh, the JSON
    // loader — and a test that imports one drags it into this program even
    // though src/frontend is excluded below. Those modules read
    // `localStorage` and `window`, which without this resolve to nothing.
    "lib": ["ES2022", "DOM"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@backend/*": ["src/backend/*"],
      "@frontend/*": ["src/frontend/*"],
      // Mirrors "@/*" in src/frontend/tsconfig.json. Same reason as the DOM
      // lib above: a frontend module pulled in by a test imports its siblings
      // by that alias, and this program has to be able to follow it.
      "@/*": ["src/frontend/*"]
    }
  },
  // src/frontend is deliberately NOT included. It has its own tsconfig
  // (src/frontend/tsconfig.json) with "jsx": "preserve" and the DOM libs,
  // and `next build` type-checks it. Compiling it here — with lib ES2022
  // and no jsx — produced 174 spurious errors: "'--jsx' is not set" for
  // every .tsx import and "Cannot find name 'window'".
  "include": [
    "src/backend/**/*.ts",
    "src/shared/**/*.ts",
    "tests/**/*.ts",
    "prisma/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", ".next", "src/frontend"]
}
