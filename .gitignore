node_modules/
dist/
.next/
# The production server's own build directory, so `next start` stops fighting
# `next dev` over one distDir. See scripts/next-prod.mjs.
.next-prod/
.env
.env.local
.env.*.local
*.log
coverage/
.vercel
.turbo
*.tsbuildinfo
.DS_Store
Thumbs.db

# Local SQLite artefacts. The datasource is PostgreSQL; a stray .db file
# here would be a leftover, not the database the app runs on.
*.db
*.db-journal
*.sqlite
*.sqlite3

# Playwright run output — traces and screenshots from local runs.
test-results/
playwright-report/

# Failure snapshots from the browser suite. Appended across runs, so it
# outlives the output directory Playwright empties on each start.
.playwright-failures.jsonl

# Local file storage. `STORAGE_PROVIDER=local` writes real files here —
# uploads from the app, and fixtures written by integration tests. None of it
# belongs in the repository; an integration test writing a PDF committed one.
uploads/
